{
  "name": "grabby",
  "version": "1.0.0",
  "private": true,
  "description": "Detect and download non-encrypted videos on any page. Chromium MV3 extension.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:store": "node scripts/build.mjs store",
    "build:github": "node scripts/build.mjs github",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
